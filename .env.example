# Kopieren nach `.env.local` und Werte aus Supabase / Cloudflare eintragen.
# Siehe auch: docs/auth-mail-setup.md

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# CLI: Migrationen auf die Remote-DB schieben (`npm run db:push`)
# Wenn die CLI meldet „Cannot find project ref“: einmal anmelden und Projekt verknüpfen (Ordner supabase/.temp/ ist gitignored).
#   1) npm run db:login
#   2) npm run db:link   → interaktiv Projekt wählen, oder: npx supabase link --project-ref YOUR_PROJECT_REF
#      (YOUR_PROJECT_REF = Subdomain aus NEXT_PUBLIC_SUPABASE_URL, z. B. abcxyz aus https://abcxyz.supabase.co)
#   3) npm run db:push
# Bei Bedarf Access Token statt Login: https://supabase.com/dashboard/account/tokens → SUPABASE_ACCESS_TOKEN in der Shell setzen.
# IPv6-/Netzwerk-Hinweise: https://supabase.com/docs/guides/troubleshooting/supabase--your-network-ipv4-and-ipv6-compatibility-cHe3BP
#
# Migration History: Lokale Dateinamen müssen zu `schema_migrations` auf der Remote-DB passen (Version = Präfix im Dateinamen).
# Sieben Dateien `2026041112000x_*.sql` standen früher unter anderen Zeitstempeln und sind auf der Remote noch nicht eingetragen:
# Beim ersten `db push` werden sie ausgeführt. Wenn Objekte schon existieren, Migration anpassen oder `supabase migration repair` nutzen.

# Nur Server (Einladungen, Admin-API, Realtime-Broadcast) – niemals im Client exponieren
# Erforderlich auf Netlify für Cross-Tab-Sync via Supabase Realtime (ersetzt /api/events SSE).
SUPABASE_SERVICE_ROLE_KEY=

# Observability (optional)
# POST JSON Core Web Vitals (LCP, INP, …) — eigener Ingest oder Analytics-Proxy
# NEXT_PUBLIC_WEB_VITALS_ENDPOINT=https://example.com/api/vitals
# Server: JSON-Warnung in stderr wenn Repo-Calls länger dauern (ms). Produktion-Default: 2000.
# Für Staging / lokale Performance-Checks in `.env.local` empfohlen:
SERVER_ACTION_SLOW_MS=800
# Manuelle Checks (Chrome DevTools / Lighthouse, Mobile Throttling): /projekte, /tag, /auftrag/<uuid>
# Büro-Projektliste: optionales Limit (Rows). Ohne Env: Code-Default 2000 neueste Projekte.
# PROJECT_LIST_MAX_ROWS=5000

# Deployment-Hinweis: App-Hosting und Supabase-Region auf Hauptnutzerbasis abstimmen (Latenz).
# Netlify Functions-Region und Supabase (z. B. eu-central-2) möglichst nah am Hauptnutzer wählen.
# Supabase Connection Pooler (Transaction Mode, Port 6543) reduziert Serverless-Connection-Overhead:
# Dashboard → Project Settings → Database → Connection string → «Transaction pooler».
# Statische Assets nutzen CDN-Cache des Hostings (Vercel/Netlify o. ä. Standard).

# Öffentliche App-URL — in `.env.local` / Netlify setzen (kein echter Host im Repo committen).
# Beispiele: http://localhost:3000 · https://ihre-app.netlify.app — OAuth-Redirects müssen exakt passen.
NEXT_PUBLIC_SITE_URL=

# E-Mail-Versand (Offerten): beliebiger SMTP-Provider (Resend, Postmark, eigener Server).
# Ohne SMTP_HOST/MAIL_FROM ist der Versand deaktiviert (Senden-Button meldet fehlende Konfiguration).
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=true   # nur für Port 465 (implizites TLS); 587 nutzt STARTTLS automatisch
SMTP_USER=
SMTP_PASS=
MAIL_FROM=offerte@example.com

# Fehler-Monitoring (Sentry, optional): ohne DSN bleibt es inaktiv, keine Codeänderung nötig.
# Server + Client brauchen denselben DSN-Wert, nur unter unterschiedlichem Namen (Client-Bundle
# darf nur NEXT_PUBLIC_*-Variablen sehen). Konto: https://sentry.io — kostenloses Tier reicht.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# PDF-Auftrags-Import («+ Neue Anfrage»): liest hochgeladene Auftrags-PDFs serverseitig
# per Anthropic-API und befüllt das Formular vor. Ohne Key ist der Import-Button inaktiv,
# die manuelle Eingabe funktioniert weiterhin. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# E-Mail-Intake: eingehende E-Mails an intake+<org-token>@INTAKE_EMAIL_DOMAIN legen
# automatisch einen Projektentwurf an (Webhook: app/api/intake/email/route.ts).
# Braucht einen Inbound-E-Mail-Provider (z. B. Postmark → Server → Settings → Inbound,
# Webhook-URL = {NEXT_PUBLIC_SITE_URL}/api/intake/email, MX-Record auf die Subdomain).
# Ohne INTAKE_EMAIL_DOMAIN ist die Funktion inaktiv (Einstellungen zeigen das an).
INTAKE_EMAIL_DOMAIN=

# Kalender-Sync raus (Google Cloud Console / Azure App Registration): eigene
# Termine automatisch in den persönlichen Google-/Microsoft-Kalender pushen —
# jede Person verbindet ihr eigenes Konto in Einstellungen.
# Redirect URIs: {NEXT_PUBLIC_SITE_URL}/api/calendar/google/callback bzw. .../microsoft/callback
# Google-Scope: https://www.googleapis.com/auth/calendar.events
# Microsoft-Scope: offline_access Calendars.ReadWrite
# Ohne Client-ID/Secret ist der jeweilige Provider in Einstellungen ausgegraut.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Admin-MFA erzwingen (true in Produktion empfohlen)
ENFORCE_ADMIN_MFA=false

# Nur für lokale Tests: Mock-Login per Cookie erlauben. In Produktion weglassen (Sicherheit).
# ALLOW_MOCK_AUTH=true

# Cloudflare Turnstile (optional)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Einmalig: npm run bootstrap:first-admin (lädt .env.local)
BOOTSTRAP_ADMIN_EMAIL=your-admin@example.com
# BOOTSTRAP_ORGANIZATION_NAME=Bauflip Organisation

# ── Selbstregistrierung (/registrieren) ──────────────────────────────────────
# closed (Standard) | code (mit REGISTRATION_CODE) | open. Fehlt/verschrieben
# = closed (Fail-Safe). Siehe lib/security/registration-mode.ts.
# REGISTRATION_MODE=closed
# REGISTRATION_CODE=
# Wer die "Neue Firma wartet auf Freigabe"-Mail mit Freigabe-/Ablehnungs-Link
# bekommt (Freigabe-Workflow, app/api/registrierung/freigabe). Ohne diese
# Adresse geht die Mail an niemanden — die Firma bleibt unbemerkt wartend.
REGISTRATION_APPROVAL_NOTIFY_EMAIL=
